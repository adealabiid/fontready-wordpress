--- /dev/null
+++ b/converter/wordpress.py
@@ -0,0 +1,87 @@
+"""Session-private export. WordPress credentials never enter the Django server."""
+import base64
+import tempfile
+import zipfile
+from pathlib import Path
+
+from django.conf import settings
+from django.http import JsonResponse, FileResponse
+from django.views.decorators.cache import never_cache
+from django.views.decorators.http import require_POST
+
+from .models import Conversion
+from .views import owner
+
+
+def font_bytes(job, filename, size):
+    if not 0 < size <= settings.MAX_FILE_BYTES or Path(filename).name != filename:
+        raise ValueError('Invalid font asset')
+    if job.storage_prefix:
+        asset = job.blob_assets.get('fonts', {}).get(filename, {})
+        path = asset.get('path', '')
+        if not path.startswith(job.storage_prefix + '/output/'):
+            raise ValueError('Invalid font scope')
+        if job.options.get('storage_backend') == 's3':
+            from . import object_storage
+            if job.storage_prefix != object_storage.prefix(job.token):
+                raise ValueError('Invalid object scope')
+            response = object_storage.client().get_object(Bucket=settings.S3_BUCKET, Key=path)
+            stream = response['Body']
+            try:
+                data = stream.read(size + 1)
+            finally:
+                stream.close()
+        else:
+            from . import cloud_storage
+            with tempfile.TemporaryDirectory() as directory:
+                target = Path(directory) / 'font'
+                cloud_storage.fetch_input(path, target, size)
+                data = target.read_bytes()
+    else:
+        with zipfile.ZipFile(settings.PRIVATE_ROOT / str(job.token) / 'fontready.zip') as archive:
+            member = archive.getinfo('fonts/' + filename)
+            if member.file_size != size:
+                raise ValueError('Invalid font size')
+            with archive.open(member) as stream:
+                data = stream.read(size + 1)
+    if len(data) != size:
+        raise ValueError('Invalid font size')
+    return data
+
+
+@never_cache
+@require_POST
+def bundle(request, token):
+    job = Conversion.objects.filter(token=token, owner=owner(request)).first()
+    if not job:
+        return JsonResponse({'error': 'Conversion not found.'}, status=404)
+    if job.expired:
+        return JsonResponse({'error': 'This kit has expired. Convert your fonts again.'}, status=410)
+    if job.state != 'ready':
+        return JsonResponse({'error': 'Your fonts are not ready.'}, status=409)
+    if not 1 <= len(job.results) <= settings.MAX_FILES:
+        return JsonResponse({'error': 'Invalid font batch.'}, status=400)
+    fonts, total = [], 0
+    try:
+        for font in job.results:
+            fmt = next((f for f in ('woff2', 'woff', 'ttf', 'otf') if f in font.get('files', {})), None)
+            if not fmt:
+                return JsonResponse({'error': 'Select WOFF2, WOFF, TTF or OTF when converting. SVG cannot be published.'}, status=400)
+            size = int(font['sizes'][fmt])
+            total += size
+            if total > settings.MAX_BATCH_BYTES:
+                return JsonResponse({'error': 'The WordPress batch exceeds 25 MB. Convert fewer fonts.'}, status=400)
+            data = font_bytes(job, font['files'][fmt], size)
+            fonts.append({'family': font['family'], 'weight': str(font['weight']),
+                          'style': font['style'], 'format': fmt,
+                          'data': base64.b64encode(data).decode('ascii')})
+    except Exception:
+        return JsonResponse({'error': 'Font files are unavailable. Try again or convert a new kit.'}, status=503)
+    return JsonResponse({'version': 1, 'fonts': fonts})
+
+
+def plugin_download(request):
+    path = settings.BASE_DIR / 'wordpress' / 'fontready-wordpress.zip'
+    if not path.is_file():
+        return JsonResponse({'error': 'Plugin download unavailable.'}, status=503)
+    return FileResponse(path.open('rb'), as_attachment=True, filename='fontready-wordpress.zip', content_type='application/zip')
