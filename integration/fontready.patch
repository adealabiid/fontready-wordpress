+"""Exercise the PHP import contract with real converted font fixtures."""
+import base64
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(root))
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'config.settings')
+import django
+django.setup()
+from converter.engine import convert
+from converter.tests import font_bytes
+
+php = os.getenv('PHP_BINARY', 'php')
+for source in (root / 'wordpress' / 'fontready').rglob('*.php'):
+    subprocess.run([php, '-n', '-l', str(source)], check=True)
+with tempfile.TemporaryDirectory() as directory:
+    folder = Path(directory)
+    (folder / 'input').mkdir()
+    data = font_bytes()
+    (folder / 'input' / '0.ttf').write_bytes(data)
+    convert(folder, [{'file': '0.ttf', 'name': 'test.ttf', 'size': len(data)}],
+            {'formats': ['woff2', 'woff', 'ttf', 'otf'], 'font_display': 'swap'})
+    result = json.loads((folder / 'result.json').read_text())['results'][0]
+    fonts = [{'family': 'FontReady Test', 'weight': str((i+1)*100), 'style': 'normal', 'format': fmt,
+              'data': base64.b64encode((folder / 'output' / name).read_bytes()).decode()}
+             for i, (fmt, name) in enumerate(result['files'].items())]
+    fixture = folder / 'fixture.json'
+    fixture.write_text(json.dumps({'version': 1, 'fonts': fonts}))
+    subprocess.run([php, '-n', str(root / 'wordpress' / 'tests' / 'plugin.php'), str(fixture)], check=True)
