@@ -0,0 +1,186 @@
+"""Session-private export. WordPress credentials never enter the Django server."""
+import base64
+import tempfile
+import zipfile
+from pathlib import Path
+
+from django.conf import settings
+from django.http import JsonResponse, FileResponse
+from django.views.decorators.cache import never_cache
+from django.views.decorators.http import require_POST
+
+from .models import Conversion
+from .views import owner
+
+
+def font_bytes(job, filename, size):
+    if not 0 < size <= settings.MAX_FILE_BYTES or Path(filename).name != filename:
+        raise ValueError('Invalid font asset')
+    if job.storage_prefix:
+        asset = job.blob_assets.get('fonts', {}).get(filename, {})
+        path = asset.get('path', '')
+        if not path.startswith(job.storage_prefix + '/output/'):
+            raise ValueError('Invalid font scope')
+        if job.options.get('storage_backend') == 's3':
+            from . import object_storage
+            if job.storage_prefix != object_storage.prefix(job.token):
+                raise ValueError('Invalid object scope')
+            response = object_storage.client().get_object(Bucket=settings.S3_BUCKET, Key=path)
+            stream = response['Body']
+            try:
+                data = stream.read(size + 1)
+            finally:
+                stream.close()
+        else:
+            from . import cloud_storage
+            with tempfile.TemporaryDirectory() as directory:
+                target = Path(directory) / 'font'
+                cloud_storage.fetch_input(path, target, size)
+                data = target.read_bytes()
+    else:
+        with zipfile.ZipFile(settings.PRIVATE_ROOT / str(job.token) / 'fontready.zip') as archive:
+            member = archive.getinfo('fonts/' + filename)
+            if member.file_size != size:
+                raise ValueError('Invalid font size')
+            with archive.open(member) as stream:
+                data = stream.read(size + 1)
+    if len(data) != size:
+        raise ValueError('Invalid font size')
+    return data
+
+
+@never_cache
+@require_POST
+def bundle(request, token):
+    job = Conversion.objects.filter(token=token, owner=owner(request)).first()
+    if not job:
+        return JsonResponse({'error': 'Conversion not found.'}, status=404)
+    if job.expired:
+        return JsonResponse({'error': 'This kit has expired. Convert your fonts again.'}, status=410)
+    if job.state != 'ready':
+        return JsonResponse({'error': 'Your fonts are not ready.'}, status=409)
+    if not 1 <= len(job.results) <= settings.MAX_FILES:
+        return JsonResponse({'error': 'Invalid font batch.'}, status=400)
+    fonts, total = [], 0
+    try:
+        for font in job.results:
+            fmt = next((f for f in ('woff2', 'woff', 'ttf', 'otf') if f in font.get('files', {})), None)
+            if not fmt:
+                return JsonResponse({'error': 'Select WOFF2, WOFF, TTF or OTF when converting. SVG cannot be published.'}, status=400)
+            size = int(font['sizes'][fmt])
+            total += size
+            if total > settings.MAX_BATCH_BYTES:
+                return JsonResponse({'error': 'The WordPress batch exceeds 25 MB. Convert fewer fonts.'}, status=400)
+            data = font_bytes(job, font['files'][fmt], size)
+            fonts.append({'family': font['family'], 'weight': str(font['weight']),
+                          'style': font['style'], 'format': fmt,
+                          'data': base64.b64encode(data).decode('ascii')})
+    except Exception:
+        return JsonResponse({'error': 'Font files are unavailable. Try again or convert a new kit.'}, status=503)
+    return JsonResponse({'version': 1, 'fonts': fonts})
+
+
+def plugin_download(request):
+    path = settings.BASE_DIR / 'wordpress' / 'fontready-wordpress.zip'
+    if not path.is_file():
+        return JsonResponse({'error': 'Plugin download unavailable.'}, status=503)
+    return FileResponse(path.open('rb'), as_attachment=True, filename='fontready-wordpress.zip', content_type='application/zip')
+
+
+import json
+import re
+import secrets
+import time
+from urllib.parse import urlsplit, urlunsplit, urlencode
+from django.shortcuts import render
+from django.views.decorators.csrf import ensure_csrf_cookie
+from .models import SiteConnection, PublishMetric
+from django.utils import timezone
+
+
+def normalize_site(value):
+    if not isinstance(value, str) or len(value) > 500:
+        raise ValueError('Enter your HTTPS website URL.')
+    parsed = urlsplit(value.strip())
+    if parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment or parsed.port not in (None, 443):
+        raise ValueError('Enter your HTTPS website URL without a query or fragment.')
+    host = parsed.hostname.lower()
+    if '.' not in host or host in ('localhost', '127.0.0.1') or ':' in host or not re.fullmatch(r'[a-z0-9.-]+', host):
+        raise ValueError('Enter your public website domain.')
+    path = parsed.path.rstrip('/')
+    if any(part in ('.', '..') for part in path.split('/')) or '%' in path or '\\' in path:
+        raise ValueError('Enter the website URL from your WordPress settings.')
+    return urlunsplit(('https', host, path+'/', '', ''))
+
+
+@never_cache
+@require_POST
+def start_connection(request):
+    try:
+        data = json.loads(request.body)
+        site = normalize_site(data.get('site'))
+        if data.get('elementor_pro') is not True:
+            raise ValueError('Confirm you have Elementor Pro installed.')
+    except (ValueError, TypeError, AttributeError):
+        return JsonResponse({'error':'Confirm Elementor Pro and enter your public HTTPS website URL.'}, status=400)
+    state = secrets.token_hex(32)
+    request.session['fontready_pair'] = {'state':state, 'site':site, 'expires':time.time()+600}
+    return JsonResponse({'url':site+'wp-admin/admin.php?'+urlencode({'page':'fontready','fontready_connect':state})})
+
+
+@never_cache
+@require_POST
+def complete_connection(request):
+    try:
+        data = json.loads(request.body)
+        pair = request.session.get('fontready_pair', {})
+        if pair.get('expires',0) < time.time() or not isinstance(data.get('state'),str) or not secrets.compare_digest(pair.get('state',''), data['state']):
+            raise ValueError('This connection request expired. Connect your website again.')
+        if normalize_site(data.get('requested_site')) != pair['site']:
+            raise ValueError('The connection does not match the requested website.')
+        site = normalize_site(data.get('site'))
+        if urlsplit(site).hostname != urlsplit(pair['site']).hostname:
+            raise ValueError('The confirmed website domain does not match.')
+        families, variants = int(data['families']), int(data['variants'])
+        if not 0 <= families <= variants <= 100:
+            raise ValueError('Invalid font totals.')
+    except (ValueError, KeyError, TypeError, AttributeError):
+        return JsonResponse({'error':'Connection could not be confirmed. Start again from FontReady.'}, status=400)
+    SiteConnection.objects.update_or_create(site=site, defaults={'last_seen':timezone.now(),'families':families,'variants':variants})
+    request.session.pop('fontready_pair', None)
+    request.session['fontready_site'] = site
+    return JsonResponse({'connected':True, 'site':site})
+
+
+@never_cache
+@require_POST
+def report_publish(request, token):
+    site = request.session.get('fontready_site')
+    job = Conversion.objects.filter(token=token, owner=owner(request), state='ready').first()
+    connection = SiteConnection.objects.filter(site=site).first()
+    if not job or not connection or job.expired:
+        return JsonResponse({'error':'Connection or conversion unavailable.'}, status=409)
+    PublishMetric.objects.get_or_create(conversion=job.token, site=connection, defaults={'face_count':len(job.results)})
+    connection.last_seen=timezone.now()
+    connection.save(update_fields=['last_seen'])
+    return JsonResponse({'recorded':True})
+
+
+@ensure_csrf_cookie
+def elementor_page(request):
+    from .seo import page_context
+    context = page_context(request)
