@@ -0,0 +1,72 @@
+/* Credentials are held only in the form, never saved or sent to FontReady. */
+(() => {
+  const get = id => document.getElementById(id);
+  const publish = get('wordpress-publish');
+  if (!publish) return;
+  let publishing = false;
+  const status = (text, error = false) => {
+    get('wordpress-status').textContent = text;
+    get('wordpress-status').className = error ? 'error' : '';
+  };
+  function connectionDetails(value) {
+    let connection;
+    try { connection = JSON.parse(value); } catch { throw new Error('Paste the complete connection details from WordPress → FontReady.'); }
+    if (typeof connection.endpoint !== 'string' || typeof connection.key !== 'string' || !/^[a-f0-9]{64}$/.test(connection.key)) throw new Error('The connection details are incomplete. Generate a new key in WordPress.');
+    let url;
+    try { url = new URL(connection.endpoint); } catch { throw new Error('The WordPress endpoint is invalid.'); }
+    const route = url.searchParams.get('rest_route');
+    const queryRoute = route === '/fontready/v1/fonts' && [...url.searchParams.keys()].length === 1;
+    const pathRoute = url.pathname.endsWith('/wp-json/fontready/v1/fonts') && !url.search;
+    if (url.protocol !== 'https:' || url.username || url.password || url.hash || !(pathRoute || queryRoute)) throw new Error('Use the HTTPS connection details generated by the FontReady plugin.');
+    return {endpoint: url.href, key: connection.key, host: url.host};
+  }
+  get('wordpress-connection').addEventListener('input', () => {
+    try { const details = connectionDetails(get('wordpress-connection').value); status(`Publish destination: ${details.host}. Review your fonts above.`); }
+    catch { status(''); }
+  });
+  get('wordpress-disconnect').onclick = () => {
+    if (publishing) return;
+    get('wordpress-connection').value = '';
+    get('wordpress-license').checked = false;
+    status('Connection cleared from this page. You can also revoke the key in WordPress.');
+  };
+  publish.onclick = async () => {
+    if (publishing) return;
+    if (previewOnly) return status('Publishing is available in the running FontReady application.', true);
+    const job = activeJob;
+    if (!job || job.state !== 'ready' || new Date(job.expires_at) <= new Date()) return status('This kit is unavailable. Convert your fonts again.', true);
+    if (!get('wordpress-license').checked) return status('Confirm that you have permission to use these fonts before publishing.', true);
+    let connection;
+    try { connection = connectionDetails(get('wordpress-connection').value); } catch (error) { return status(error.message, true); }
+    publishing = true;
+    publish.disabled = true;
+    get('wordpress-connection').disabled = true;
+    get('wordpress-disconnect').disabled = true;
+    status(`Preparing your fonts for ${connection.host}…`);
+    try {
+      const payload = await api(`/api/conversions/${job.id}/wordpress/`, {method: 'POST', headers: {'X-CSRFToken': csrf()}, signal: AbortSignal.timeout(120000)});
+      if (activeJob?.id !== job.id) throw new Error('The active kit changed. Review it and publish again.');
+      status(`Publishing to ${connection.host}…`);
+      let response;
+      try {
+        response = await fetch(connection.endpoint, {method: 'POST', credentials: 'omit', redirect: 'error', referrerPolicy: 'no-referrer', signal: AbortSignal.timeout(120000), headers: {'Content-Type': 'application/json', 'Authorization': `Bearer ${connection.key}`}, body: JSON.stringify(payload)});
+      } catch {
+        throw new Error('Could not confirm publishing. Check WordPress → FontReady before retrying. Check HTTPS, REST API access and your security plugin if no fonts appeared.');
+      }
+      const data = await response.json().catch(() => null);
+      if (!response.ok) {
+        if (response.status === 401) get('wordpress-connection').value = '';
+        throw new Error(data?.message || `WordPress returned ${response.status}. Check the plugin and try again.`);
+      }
+      if (!Array.isArray(data?.families) || !Number.isInteger(data?.imported)) throw new Error('WordPress returned an unexpected response. Check FontReady in WordPress before retrying.');
+      status(`Published to ${connection.host}: ${data.families.join(', ')}. Refresh the Elementor editor to use your fonts under FontReady.`);
+    } catch (error) { status(error.message, true); }
+    finally {
+      connection = null;
+      publishing = false;
+      publish.disabled = false;
+      get('wordpress-connection').disabled = false;
+      get('wordpress-disconnect').disabled = false;
+    }
+  };
+})();
