+/* Opaque authentication stays in this browser tab; the user never copies a key. */
+(() => {
+  const get = id => document.getElementById(id);
+  const storageKey = 'fontready.website.v2';
+  let connection = null, publishing = false;
+  const message = (text, error = false, id = 'connection-status') => {
+    const element = get(id) || get('wordpress-status');
+    if (element) { element.textContent = text; element.className = error ? 'error' : ''; }
+  };
+  const clear = () => { connection = null; sessionStorage.removeItem(storageKey); };
+  function endpoint(value, route, site) {
+    const url = new URL(value), origin = new URL(site);
+    const query = url.searchParams.get('rest_route');
+    const queryRoute = query === `/fontready/v1/${route}` && [...url.searchParams.keys()].length === 1;
+    const pathRoute = url.pathname.endsWith(`/wp-json/fontready/v1/${route}`) && !url.search;
+    if (url.protocol !== 'https:' || url.origin !== origin.origin || url.username || url.password || url.hash || !(pathRoute || queryRoute)) throw new Error('WordPress returned an invalid connection endpoint.');
+    if (queryRoute && !url.pathname.endsWith('/')) throw new Error('WordPress returned an invalid connection path.');
+    return url.href;
+  }
+  function validate(data, site) {
+    if (!data || !/^[a-f0-9]{64}$/.test(data.key) || !Number.isInteger(data.expires) || data.expires * 1000 <= Date.now() || data.expires * 1000 > Date.now() + 8 * 86400000) throw new Error('Reconnect your website to FontReady.');
+    const canonical = new URL(data.site);
+    if (canonical.protocol !== 'https:' || canonical.origin !== new URL(site).origin || canonical.username || canonical.password || canonical.search || canonical.hash) throw new Error('The website domain does not match.');
+    return {...data, endpoint: endpoint(data.endpoint, 'fonts', site), status: endpoint(data.status, 'connection', site)};
+  }
+  try { const saved = JSON.parse(sessionStorage.getItem(storageKey) || 'null'); if (saved) connection = validate(saved, saved.site); }
+  catch { try { clear(); } catch {} }
+  const showConnection = () => {
+    if (connection) {
+      if (get('wordpress-site')) get('wordpress-site').value = connection.site;
+      message(`Connected to ${new URL(connection.site).host}. Your website is ready.`);
+    }
+  };
+  showConnection();
+  if (get('wordpress-connect')) get('wordpress-connect').onclick = async () => {
+    const button = get('wordpress-connect');
+    if (previewOnly) return message('Connect from the running FontReady website.', true);
+    button.disabled = true;
+    try {
+      const site = get('wordpress-site').value.trim();
+      sessionStorage.setItem('fontready.requested-site', site);
+      const result = await api('/api/wordpress/connect/', {method:'POST', headers:{'Content-Type':'application/json','X-CSRFToken':csrf()}, body:JSON.stringify({site, elementor_pro:get('wordpress-pro').checked})});
+      location.assign(result.url);
+    } catch (error) { message(error.message, true); button.disabled = false; }
+  };
+  const callback = window.fontreadyCallback;
+  delete window.fontreadyCallback;
+  if (callback) (async () => {
+    try {
+      clear();
+      const requested = sessionStorage.getItem('fontready.requested-site');
+      if (!requested || !/^[a-f0-9]{64}$/.test(callback.state)) throw new Error('Start your connection from FontReady again.');
+      const candidate = validate(callback, requested);
+      const response = await fetch(candidate.status, {credentials:'omit',redirect:'error',referrerPolicy:'no-referrer',signal:AbortSignal.timeout(20000),headers:{Authorization:`Bearer ${candidate.key}`}});
+      if (!response.ok) throw new Error('WordPress could not confirm your connection. Check Elementor Pro and reconnect.');
+      const status = await response.json();
+      if (status.elementor_pro !== true || new URL(status.site).href !== new URL(candidate.site).href) throw new Error('WordPress could not confirm this website.');
+      await api('/api/wordpress/complete/', {method:'POST',headers:{'Content-Type':'application/json','X-CSRFToken':csrf()},body:JSON.stringify({state:callback.state,requested_site:requested,site:status.site,families:status.families,variants:status.variants})});
+      delete candidate.state;
+      connection = candidate;
+      sessionStorage.setItem(storageKey, JSON.stringify(candidate));
+      sessionStorage.removeItem('fontready.requested-site');
+      showConnection();
+    } catch (error) { message(error.message, true); }
+  })();
+  if (get('wordpress-disconnect')) get('wordpress-disconnect').onclick = () => {
+    if (publishing) return;
+    clear(); message('Disconnected from this browser. You can disconnect all access in WordPress → FontReady.');
+  };
+  const publish = get('wordpress-publish');
+  if (!publish) return;
+  publish.onclick = async () => {
+    if (publishing) return;
+    const status = (text, error=false) => message(text,error,'wordpress-status');
+    if (previewOnly) return status('Publishing is available in the running FontReady application.',true);
+    if (!connection) return status('Connect your website from “Font to Elementor Pro” in the top menu.',true);
+    const job = activeJob;
+    if (!job || job.state !== 'ready' || new Date(job.expires_at) <= new Date()) return status('Convert your fonts again; this kit is unavailable.',true);
+    publishing = true; publish.disabled = true;
+    try {
+      connection = validate(connection, connection.site);
+      const host = new URL(connection.site).host;
+      status(`Installing fonts on ${host}…`);
+      const payload = await api(`/api/conversions/${job.id}/wordpress/`, {method:'POST',headers:{'X-CSRFToken':csrf()},signal:AbortSignal.timeout(120000)});
+      if (activeJob?.id !== job.id) throw new Error('The active kit changed. Review it and install again.');
+      const response = await fetch(connection.endpoint,{method:'POST',credentials:'omit',redirect:'error',referrerPolicy:'no-referrer',signal:AbortSignal.timeout(120000),headers:{'Content-Type':'application/json',Authorization:`Bearer ${connection.key}`},body:JSON.stringify(payload)});
+      const data = await response.json().catch(()=>null);
+      if (!response.ok) {
+        if (response.status === 401) clear();
+        throw new Error(data?.message || `WordPress returned ${response.status}. Check your website and try again.`);
+      }
+      if (!Array.isArray(data?.families) || !Number.isInteger(data?.imported)) throw new Error('Check WordPress → FontReady to confirm the installation before retrying.');
+      status(`Installed on ${host}: ${data.families.join(', ')}. Refresh Elementor and select your font under FontReady.`);
+      api(`/api/conversions/${job.id}/published/`,{method:'POST',headers:{'X-CSRFToken':csrf()}}).catch(()=>{});
+    } catch (error) { status(error.message || 'Check WordPress → FontReady before retrying.',true); }
+    finally { publishing=false; publish.disabled=false; }
+  };
+})();
