+"""Reproducible, installable ZIP. No build tools required on the WordPress host."""
+from pathlib import Path
+import zipfile
+
+root = Path(__file__).resolve().parent.parent
+source = root / 'wordpress' / 'fontready'
+target = root / 'wordpress' / 'fontready-wordpress.zip'
+with zipfile.ZipFile(target, 'w', compression=zipfile.ZIP_DEFLATED) as archive:
+    for path in sorted(source.rglob('*')):
+        if path.is_file():
+            member = zipfile.ZipInfo(str(path.relative_to(source.parent)), (2026, 1, 1, 0, 0, 0))
+            member.compress_type = zipfile.ZIP_DEFLATED
+            member.external_attr = 0o644 << 16
+            archive.writestr(member, path.read_bytes())
+print(target)
