+/* Strip connection fragments before any third-party script loads. Never send credentials to Django. */
+(() => {
+  if (!location.hash.startsWith('#fontready=')) return;
+  const value = location.hash.slice(11);
+  history.replaceState(null, '', location.pathname + location.search);
+  try { window.fontreadyCallback = JSON.parse(decodeURIComponent(value)); }
+  catch { window.fontreadyCallback = {invalid: true}; }
+})();
