+
+class ConnectionTests(TestCase):
+    def start(self):
+        response=self.client.post('/api/wordpress/connect/',data=json.dumps({'site':'https://example.com/','elementor_pro':True}),content_type='application/json')
+        self.assertEqual(response.status_code,200)
+        return parse_qs(urlsplit(response.json()['url']).query)['fontready_connect'][0]
+    def complete(self,state,site='https://example.com/'):
+        return self.client.post('/api/wordpress/complete/',data=json.dumps({'state':state,'requested_site':'https://example.com/','site':site,'families':2,'variants':3}),content_type='application/json')
+    def test_pairing_is_session_owned_and_single_use(self):
+        state=self.start()
+        self.assertEqual(self.complete('a'*64).status_code,400)
+        self.assertEqual(Client().post('/api/wordpress/complete/',data=json.dumps({'state':state}),content_type='application/json').status_code,400)
+        self.assertEqual(self.complete(state,'https://other.com/').status_code,400)
+        response=self.complete(state)
+        self.assertEqual(response.status_code,200)
+        self.assertNotIn('key',response.json())
+        self.assertEqual(SiteConnection.objects.get().variants,3)
+        self.assertEqual(self.complete(state).status_code,400)
+    def test_expiry_csrf_and_unsafe_urls(self):
+        state=self.start();session=self.client.session
+        pair=session['fontready_pair'];pair['expires']=0;session['fontready_pair']=pair;session.save()
+        self.assertEqual(self.complete(state).status_code,400)
+        for site in ('http://example.com/','https://user:pass@example.com/','https://example.com/#x','https://example.com/?x=y','https://localhost/','https://example.com/../'):
+            self.assertEqual(self.client.post('/api/wordpress/connect/',data=json.dumps({'site':site,'elementor_pro':True}),content_type='application/json').status_code,400)
+        self.assertEqual(Client(enforce_csrf_checks=True).post('/api/wordpress/connect/',data='{}',content_type='application/json').status_code,403)
+        self.assertEqual(self.client.get('/api/wordpress/connect/').status_code,405)
+        self.assertEqual(self.client.post('/api/wordpress/connect/',data=json.dumps({'site':'https://example.com/','elementor_pro':False}),content_type='application/json').status_code,400)
+    def test_publish_reports_deduplicate_and_require_owner(self):
+        self.complete(self.start());session=self.client.session
+        job=Conversion.objects.create(owner=session.session_key,state='ready',results=[{'family':'Example','sizes':{'woff2':100}}],expires_at=timezone.now()+timedelta(minutes=24))
+        url=f'/api/conversions/{job.token}/published/'
+        self.assertEqual(self.client.post(url).status_code,200)
+        self.assertEqual(self.client.post(url).status_code,200)
+        self.assertEqual(PublishMetric.objects.count(),1)
+        self.assertEqual(Client().post(url).status_code,409)
+    def test_callback_strip_script_is_first_and_landing_seo(self):
+        page=self.client.get('/font-to-elementor-pro/').content.decode()
+        self.assertIn('Font to Elementor Pro',page)
+        self.assertIn('https://fontready.com/font-to-elementor-pro/',page)
+        self.assertLess(page.index('wordpress-callback.js'),page.index('application/ld+json'))
+        self.assertNotIn('Generate connection key',page)
