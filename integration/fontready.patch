+{% load static %}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>FontReady · Owner dashboard</title><link rel="stylesheet" href="{% static 'app.css' %}"><link rel="stylesheet" href="{% static 'owner.css' %}"></head><body><main class="shell owner"><header><a class="brand" href="/">FontReady<span>.</span></a><span>Owner dashboard</span><form action="/owner/logout/" method="post">{% csrf_token %}<button class="text-button">Sign out</button></form></header><h1>Your fonts, in numbers.</h1><p class="muted">Successful conversions recorded on the server. Daily totals use Lagos time.</p><nav class="periods"><a href="?period=week" {% if period == 'week' %}aria-current="page"{% endif %}>Last 7 days</a><a href="?period=month" {% if period == 'month' %}aria-current="page"{% endif %}>Last 30 days</a><a href="?period=year" {% if period == 'year' %}aria-current="page"{% endif %}>Last 365 days</a></nav><div class="metrics"><article><strong>{{ total }}</strong><span>Completed conversions</span></article><article><strong>{{ faces }}</strong><span>Font variants converted</span></article><article><strong>{{ site_count }}</strong><span>Connected domains · all time</span></article><article><strong>{{ publishes }}</strong><span>Reported installations</span></article></div><div class="owner-grid"><section><h2>Daily conversions</h2><table><thead><tr><th>Date</th><th>Completed batches</th></tr></thead><tbody>{% for row in daily %}<tr><td>{{ row.day|date:'M j, Y' }}</td><td>{{ row.total }}</td></tr>{% empty %}<tr><td colspan="2">No conversions recorded yet.</td></tr>{% endfor %}</tbody></table></section><section><h2>Top fonts · {{ period }}</h2><p class="muted">Counts converted variants, including repeat conversions.</p><table><thead><tr><th>Font family</th><th>Variants converted</th></tr></thead><tbody>{% for family, count in top %}<tr><td>{{ family }}</td><td>{{ count }}</td></tr>{% empty %}<tr><td colspan="2">Your top fonts will appear here.</td></tr>{% endfor %}</tbody></table></section></div><section><h2>Elementor site connections</h2><p class="muted">Browser-reported after WordPress authentication. Shows up to 100 recent domains. These are historical connections, not a live check of plugin status. Font counts are snapshots at connection time.</p><table><thead><tr><th>Website</th><th>Fonts / variants</th><th>First connected</th><th>Last activity</th></tr></thead><tbody>{% for site in sites %}<tr><td>{{ site.site }}</td><td>{{ site.families }} / {{ site.variants }}</td><td>{{ site.first_seen|date:'M j, Y' }}</td><td>{{ site.last_seen|date:'M j, Y H:i' }}</td></tr>{% empty %}<tr><td colspan="4">No websites connected yet.</td></tr>{% endfor %}</tbody></table></section><p class="muted">Statistics begin with this release. Expiring conversion files are deleted independently of these counts. No visitor IP addresses, connection secrets or font files are stored in this dashboard.</p></main></body></html>
