new file mode 100644
index 0000000..5b9d24b
--- /dev/null
+++ b/converter/metrics.py
@@ -0,0 +1,48 @@
+"""Aggregate conversion counts are independent of expiring source jobs."""
+from collections import Counter
+from datetime import timedelta, datetime, time
+from zoneinfo import ZoneInfo
+from django.contrib.auth.decorators import login_required
+from django.core.exceptions import PermissionDenied
+from django.db.models import Count
+from django.db.models.functions import TruncDate
+from django.db.models.signals import post_save
+from django.dispatch import receiver
+from django.shortcuts import render
+from django.utils import timezone
+from django.views.decorators.cache import never_cache
+from .models import Conversion, ConversionMetric, SiteConnection, PublishMetric
+
+
+def record_conversion(job):
+    if job.state != 'ready' or not job.results:
+        return
+    ConversionMetric.objects.get_or_create(token=job.token, defaults={
+        'created_at': job.created_at, 'fonts': [f['family'][:100] for f in job.results if isinstance(f.get('family'), str)],
+        'face_count': len(job.results), 'formats': sorted({fmt for f in job.results for fmt in f.get('sizes', {})})})
+
+
+@receiver(post_save, sender=Conversion)
+def converted(sender, instance, **kwargs):
+    record_conversion(instance)
+
+
+@never_cache
+@login_required(login_url='/owner/login/')
+def dashboard(request):
+    if not request.user.is_superuser:
+        raise PermissionDenied
+    now = timezone.now()
+    period = request.GET.get('period', 'week')
+    days = {'week': 7, 'month': 30, 'year': 365}.get(period, 7)
+    period = period if period in ('week', 'month', 'year') else 'week'
+    today = now.astimezone(ZoneInfo('Africa/Lagos')).date()
+    start = datetime.combine(today-timedelta(days=days-1), time.min, tzinfo=ZoneInfo('Africa/Lagos'))
+    records = ConversionMetric.objects.filter(created_at__gte=start)
+    top = Counter(family for fonts in records.values_list('fonts', flat=True) for family in fonts)
+    counts = {row['day']:row['total'] for row in records.annotate(day=TruncDate('created_at', tzinfo=ZoneInfo('Africa/Lagos'))).values('day').annotate(total=Count('id'))}
+    daily = [{'day':today-timedelta(days=i), 'total':counts.get(today-timedelta(days=i),0)} for i in range(days)]
+    return render(request, 'owner/dashboard.html', {'period':period, 'days':days, 'daily':daily,
+        'top':top.most_common(20), 'total':records.count(), 'faces':sum(records.values_list('face_count',flat=True)),
+        'sites':SiteConnection.objects.order_by('-last_seen')[:100], 'site_count':SiteConnection.objects.count(),
+        'publishes':PublishMetric.objects.filter(created_at__gte=start).count()})
