+import base64
+import io
+import tempfile
+from datetime import timedelta
+from pathlib import Path
+from unittest.mock import patch, Mock
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import TestCase, Client, override_settings
+from django.utils import timezone
+from fontTools.ttLib import TTFont
+from .models import Conversion
+from .jobs import run_next
+from .tests import font_bytes
+
+
+class WordPressExportTests(TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        settings = override_settings(PRIVATE_ROOT=Path(temp.name), AI_ENABLED=False)
+        settings.enable()
+        self.addCleanup(settings.disable)
+
+    def convert(self, formats=('woff2', 'woff')):
+        response = self.client.post('/api/conversions/', {'fonts': SimpleUploadedFile('test.ttf', font_bytes()), 'formats': list(formats)})
+        self.assertEqual(response.status_code, 202)
+        run_next()
+        self.job = Conversion.objects.get()
+        self.assertEqual(self.job.state, 'ready', self.job.error)
+        self.url = f'/api/conversions/{self.job.token}/wordpress/'
+        return self.job
+
+    def test_export_prefers_woff2_and_roundtrips_real_font(self):
+        job = self.convert()
+        response = self.client.post(self.url)
+        self.assertEqual(response.status_code, 200)
+        font = response.json()['fonts'][0]
+        self.assertEqual(font['format'], 'woff2')
+        self.assertEqual(font['family'], job.results[0]['family'])
+        with TTFont(io.BytesIO(base64.b64decode(font['data']))) as parsed:
+            self.assertEqual(parsed.getBestCmap(), {32: 'space', 65: 'A', 66: 'B'})
+        self.assertIn('no-store', response['Cache-Control'])
+
+    def test_owner_expiry_readiness_csrf_and_method(self):
+        job = self.convert()
+        self.assertEqual(Client().post(self.url).status_code, 404)
+        self.assertEqual(self.client.get(self.url).status_code, 405)
+        csrf_client = Client(enforce_csrf_checks=True)
+        csrf_client.cookies = self.client.cookies.copy()
+        self.assertEqual(csrf_client.post(self.url).status_code, 403)
+        job.state = 'processing'
+        job.save()
+        self.assertEqual(self.client.post(self.url).status_code, 409)
+        job.state = 'ready'
+        job.expires_at = timezone.now() - timedelta(seconds=1)
+        job.save()
+        self.assertEqual(self.client.post(self.url).status_code, 410)
+
+    def test_svg_only_is_not_publishable(self):
+        self.convert(('svg',))
+        self.assertEqual(self.client.post(self.url).status_code, 400)
+
+    def test_s3_export_is_scoped_and_closes_stream(self):
+        job = self.convert(('ttf',))
+        name = job.results[0]['files']['ttf']
+        data = font_bytes()
+        job.results[0]['sizes']['ttf'] = len(data)
+        job.storage_prefix = f'fontready-test/{job.token}'
+        job.options['storage_backend'] = 's3'
+        job.blob_assets = {'fonts': {name: {'path': job.storage_prefix + '/output/' + name}}}
+        job.save()
+        stream = io.BytesIO(data)
+        client = Mock()
+        client.get_object.return_value = {'Body': stream}
+        with patch('converter.object_storage.client', return_value=client):
+            self.assertEqual(self.client.post(self.url).status_code, 200)
+            self.assertTrue(stream.closed)
+            job.blob_assets['fonts'][name]['path'] = 'other-job/output/font.ttf'
+            job.save()
+            self.assertEqual(self.client.post(self.url).status_code, 503)
+            self.assertEqual(client.get_object.call_count, 1)
+
+    def test_blob_export_and_oversized_asset(self):
+        job = self.convert(('ttf',))
+        name = job.results[0]['files']['ttf']
+        data = font_bytes()
+        job.results[0]['sizes']['ttf'] = len(data)
+        job.storage_prefix = f'blob/{job.token}'
+        job.blob_assets = {'fonts': {name: {'path': job.storage_prefix + '/output/' + name}}}
+        job.save()
+        def fetch(path, target, size):
+            target.write_bytes(data)
+        with patch('converter.cloud_storage.fetch_input', side_effect=fetch) as storage:
+            self.assertEqual(self.client.post(self.url).status_code, 200)
+            job.results[0]['sizes']['ttf'] = 6 * 1024 * 1024
+            job.save()
+            self.assertEqual(self.client.post(self.url).status_code, 503)
+            self.assertEqual(storage.call_count, 1)
+
+    def test_missing_archive_and_downloadable_plugin(self):
+        job = self.convert()
+        from django.conf import settings
+        (settings.PRIVATE_ROOT / str(job.token) / 'fontready.zip').unlink()
+        self.assertEqual(self.client.post(self.url).status_code, 503)
+        download = self.client.get('/wordpress-plugin/')
+        self.assertEqual(download.status_code, 200)
+        self.assertEqual(download['Content-Type'], 'application/zip')
+        download.close()
