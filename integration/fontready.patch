new file mode 100644
index 0000000..957a632
--- /dev/null
+++ b/converter/eot_export.py
@@ -0,0 +1,24 @@
+"""Uncompressed EOT 1.0 wrapper, preserving the embedded sfnt and embedding flags."""
+import io
+import struct
+from fontTools.ttLib import TTFont
+
+
+def eot_bytes(sfnt):
+    with TTFont(io.BytesIO(sfnt), recalcTimestamp=False) as font:
+        os2, head, names = font['OS/2'], font['head'], font['name']
+        panose = bytes(getattr(os2.panose, key) for key in (
+            'bFamilyType', 'bSerifStyle', 'bWeight', 'bProportion', 'bContrast',
+            'bStrokeVariation', 'bArmStyle', 'bLetterForm', 'bMidline', 'bXHeight'))
+        strings = b''.join(b'\0\0' + struct.pack('<H', len(value)) + value
+                           for value in ((names.getDebugName(i) or '').encode('utf-16le')
+                                         for i in (1, 2, 5, 4)))
+        header = struct.pack('<IIII10sBBIHH7I4I', 80 + len(strings) + len(sfnt),
+                             len(sfnt), 0x10000, 0, panose, 1,
+                             int(bool(os2.fsSelection & 1)), os2.usWeightClass,
+                             os2.fsType, 0x504C,
+                             *(getattr(os2, key, 0) for key in (
+                                 'ulUnicodeRange1', 'ulUnicodeRange2', 'ulUnicodeRange3',
+                                 'ulUnicodeRange4', 'ulCodePageRange1', 'ulCodePageRange2')),
+                             head.checkSumAdjustment, 0, 0, 0, 0)
+        return header + strings + sfnt
