index 0000000..2e5797a
--- /dev/null
+++ b/converter/elementor_files.py
@@ -0,0 +1,34 @@
+"""Prepare a full native Elementor set from a session-owned, converted font."""
+import json
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from django.conf import settings
+
+FORMATS = ('woff2', 'woff', 'ttf', 'svg', 'eot')
+
+
+def complete_files(font, read):
+    if all(fmt in font.get('files', {}) for fmt in FORMATS):
+        return {fmt: read(fmt) for fmt in FORMATS}
+    source = next((fmt for fmt in ('woff2', 'woff', 'ttf', 'otf') if fmt in font.get('files', {})), None)
+    if source is None:
+        raise ValueError('Convert a TTF, OTF, WOFF or WOFF2 font before publishing.')
+    with tempfile.TemporaryDirectory() as directory:
+        root = Path(directory)
+        (root / 'input').mkdir()
+        data = read(source)
+        filename = 'source.' + source
+        (root / 'input' / filename).write_bytes(data)
+        (root / 'job.json').write_text(json.dumps({
+            'manifest': [{'name':font.get('name',font['family']+'.'+source), 'file':filename, 'size':len(data)}],
+            'options': {'formats':list(FORMATS), 'font_display':'swap', 'profile':'elementor'}}))
+        subprocess.run([sys.executable, '-m', 'converter.engine', directory], cwd=settings.BASE_DIR,
+                       timeout=settings.PROCESS_TIMEOUT, check=True, capture_output=True)
+        result = json.loads((root / 'result.json').read_text())['results'][0]
+        missing = set(FORMATS) - set(result['files'])
+        if missing:
+            raise ValueError('This font could not produce the complete Elementor set: ' + ', '.join(sorted(missing)) + '. Try a static TTF or OTF font.')
+        return {fmt: (root / 'output' / result['files'][fmt]).read_bytes()
+                for fmt in FORMATS if fmt in result['files']}
